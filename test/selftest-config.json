{
    "system": {},
    "supervisor": {
        "imagePath": "./wasm/supervisor/selftest/supervisor.tar",
        "params": {
            "privileged": true,
            "console": {
                "in":  {"name": "platform"},
                "out": {"name": "platform"},
                "err": {"name": "platform"}
            },
            "drivers": [
                {"name": "wanted"},
                {"name": "pipe", "options": "read=selftest,write=selftest,read=wasipoll,write=wasipoll"},
                {"name": "pipe", "options": "read=wasiflags,write=wasiflags,read=renuma,write=renuma"},
                {"name": "pipe", "options": "read=renumb,write=renumb,read=duplex,write=duplex"},
                {"name": "pipe", "options": "read=argpipe.out"},
                {"name": "ota"}
            ],
            "mounts": [
                {"name": "config", "path": "/etc/config", "options": "selftest-cfgmap-v1"},
                {"name": "platform", "path": "/host", "options": "src=/tmp/wanted-selftest-host"},
                {"name": "log", "path": "/log"}
            ],
            "sockets": [
                {"name": "uplink", "address": "tcp://localhost:8899"}
            ]
        }
    }
}
