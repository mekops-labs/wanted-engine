{
    "system": {
        "privileged": true
    },
    "supervisor": {
        "imagePath": "/data/wanted/supervisor.tar",
        "params": {
            "console": {
                "in":  {"name": "platform"},
                "out": {"name": "platform"},
                "err": {"name": "platform"}
            },
            "drivers": [
                {"name": "wanted"}
            ],
            "mounts": [
                {"name": "platform", "path": "/var/lib/sheriff", "options": "src=sheriff"}
            ]
        }
    }
}
