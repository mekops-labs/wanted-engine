# Adafruit Feather RP2350 under NuttX — identical to
# rp2350_feather_sheriff_defconfig, for the one segment of the talk demo where
# a second, ordinary wapp (wsh) is granted the native console instead of
# Sheriff.
CONFIG_WANTED_MAX_WAPPS=16
CONFIG_WANTED_WASM_STACK_SIZE=65536
CONFIG_WANTED_WASM_HEAP_SIZE=262144
CONFIG_WANTED_WASM_WORKER_STACK_SIZE=65536
CONFIG_WANTED_WASM_MAX_MEMORY_PAGES=16
CONFIG_WANTED_MAX_PATH_LEN=512
CONFIG_WANTED_MAX_DRIVERS_CNT=8
CONFIG_WANTED_MAX_OPTIONS_SIZE=256

CONFIG_WANTED_SUPERVISOR_SHERIFF=y
CONFIG_WANTED_DEFAULT_CONFIG="configs/demo-rp2350-serial-wsh.json"

CONFIG_WANTED_WAPP_IMAGE_VERIFY_ENFORCE=y

CONFIG_WANTED_TARGET_NUTTX=y
CONFIG_WANTED_TARGET_NUTTX_BOARD="adafruit-feather-rp2350:sheriff"
CONFIG_WANTED_TARGET_NUTTX_DEFCONFIG="rp2350_feather_sheriff_wsh_demo"
