# XIAO ESP32-S3 (ESP-IDF, octal PSRAM) — the edge MCU of the Telegraph
# display. Same capacity envelope as xiao_esp32s3, with the serial-port driver
# built in: the wapp that brokers the link to the display's own MCU holds a
# uart grant, and that driver is off by default.
#
# The supervisor is the one of the control plane, which is what a deployed
# board runs: it takes the wapps of the device from a registry over the
# network, into the registry partition.

# A supervisor image is the largest thing the registry holds, and 192 KiB
# covers one. Sixteen of those slots fill the same partition, and a rollout
# needs two versions of every wapp of the deployment at once.
CONFIG_WANTED_MAX_WAPPS=16
CONFIG_WANTED_MAX_WAPP_IMAGE_KB=192
CONFIG_WANTED_WASM_STACK_SIZE=65536
CONFIG_WANTED_WASM_HEAP_SIZE=0
CONFIG_WANTED_WASM_WORKER_STACK_SIZE=65536
CONFIG_WANTED_WASM_MAX_MEMORY_PAGES=3
CONFIG_WANTED_MAX_PATH_LEN=256
CONFIG_WANTED_MAX_DRIVERS_CNT=6
CONFIG_WANTED_MAX_OPTIONS_SIZE=128

CONFIG_WANTED_VFS_UART=y

# Two pipes per peer is the convention of the broker, and the wapps of this
# board reach both the broker and the display that way. Eight pipes serve four
# such links; sixteen serve eight. The store is one heap allocation in the
# external RAM this board carries, thus the eight added pipes cost ~33 KiB of
# the megabytes free there.
CONFIG_WANTED_PIPE_MAX_PIPES=16

# The wapp of the display serves its REST surface from inside the sandbox.
CONFIG_WANTED_VFS_SOCKET_LISTEN=y

CONFIG_WANTED_SUPERVISOR_SHERIFF=y
CONFIG_WANTED_DEFAULT_CONFIG="configs/bringup-esp32s3-telegraph-sheriff.json"
CONFIG_WANTED_ESP_IDF_WIFI_BOOT_JOIN=y

# Makes `just defconfig xiao_esp32s3-telegraph-sheriff && just build` alone
# reach the right target, chip and board (no DEFCONFIG override needed).
CONFIG_WANTED_TARGET_ESP_IDF=y
CONFIG_WANTED_TARGET_ESP_IDF_CHIP="esp32s3"
CONFIG_WANTED_TARGET_ESP_IDF_DEFCONFIG="xiao_esp32s3-telegraph-sheriff"
