# Classic ESP32 (Waveshare ESP32 One) under ESP-IDF.
#
# Worker stacks are internal DRAM here (platform/esp-idf/wapps.c gates on
# CONFIG_IDF_TARGET_ESP32): a flash op fully disables this chip's cache, so a
# PSRAM stack is unreachable during that window and ESP-IDF asserts
# (esp_task_stack_is_sane_cache_disabled) the moment a flash-touching worker
# uses one -- confirmed on hardware. 24 KiB matches the retired NuttX build's
# constrained-envelope stack size.
#
# MAX_WAPPS=5: the classic part is a reference node, not the concurrency
# target (that's the S3), but app_main.c's own boot-time fixtures
# (looper/wifi-connect/devcheck) permanently occupy 3 registry slots, and the
# concurrent-install selftest needs at least one more free slot to install
# into while they run -- 3 alone leaves zero headroom (ENOSPC on every
# round). Raise further once the real internal-DRAM ceiling is measured.

CONFIG_WANTED_MAX_WAPPS=5
CONFIG_WANTED_WASM_STACK_SIZE=8192
CONFIG_WANTED_WASM_HEAP_SIZE=8192
CONFIG_WANTED_WASM_WORKER_STACK_SIZE=24576
CONFIG_WANTED_WASM_MAX_MEMORY_PAGES=1
CONFIG_WANTED_MAX_PATH_LEN=256
CONFIG_WANTED_MAX_DRIVERS_CNT=6
CONFIG_WANTED_MAX_OPTIONS_SIZE=128

# wsh is what the S3 bring-up config also embeds; the bring-up config grants
# it the ota driver, a log mount and reachability sockets. esp_ota_ops calls
# compile in but have nothing to roll back to on this chip's single-slot
# layout (esp32-factory OTA_PROFILE) -- fine for a wsh bring-up shell.
CONFIG_WANTED_SUPERVISOR_WSH=y
CONFIG_WANTED_DEFAULT_CONFIG="configs/bringup-esp32s3.json"
