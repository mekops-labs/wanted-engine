{
    "system": {},
    "supervisor": {
        "imagePath": "./wasm/supervisor/sheriff/supervisor.tar",
        "params": {
            "privileged": true,
            "console": {
                "in":  {"name": "platform"},
                "out": {"name": "platform"},
                "err": {"name": "platform"}
            },
            "drivers": [
                {"name": "wanted"},
                {"name": "sha256"},
                {"name": "ed25519"},
                {"name": "inflate"},
                {"name": "wbus", "options": "serve=supervisor"}
            ],
            "mounts": [
                {"name": "platform", "path": "/var/lib/sheriff"},
                {"name": "log", "path": "/logs"}
            ]
        }
    }
}
