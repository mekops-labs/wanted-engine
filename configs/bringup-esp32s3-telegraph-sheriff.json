{
    "system": { "privileged": true },
    "supervisor": {
        "imagePath": "registry:supervisor",
        "params": {
            "console": {
                "in":  {"name": "platform"},
                "out": {"name": "platform"},
                "err": {"name": "log"}
            },
            "drivers": [
                {"name": "wanted"},
                {"name": "ota"},
                {"name": "sha256"},
                {"name": "ed25519"},
                {"name": "inflate"}
            ],
            "mounts": [
                {"name": "platform", "path": "/var/lib/sheriff", "options": "src=sheriff"},
                {"name": "log", "path": "/logs"}
            ],
            "envs": [
                "SHERIFF_SYNC_INTERVAL_S=5"
            ]
        }
    }
}
