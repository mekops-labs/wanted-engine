# Pimoroni Pico 2 Plus W under NuttX, RP2350 + PSRAM + CYW43439 — wsh debug
# shell instead of Sheriff. Matches pimoroni-pico-2-plus-w:wsh, which carries
# the same wireless/hardware config as :sheriff and differs only in which
# supervisor the boot ROMFS bundles (see that board's Kconfig comment).
#
# Exists to drive the control plane by hand on the one WANTED board with a
# radio, e.g. to grant a wapp `wifi` and exercise /dev/wifi interactively —
# something no other board:variant combination in the pinned fork can do.

CONFIG_WANTED_MAX_WAPPS=16
CONFIG_WANTED_WASM_STACK_SIZE=65536
CONFIG_WANTED_WASM_HEAP_SIZE=262144
CONFIG_WANTED_WASM_WORKER_STACK_SIZE=65536
CONFIG_WANTED_WASM_MAX_MEMORY_PAGES=16
CONFIG_WANTED_MAX_PATH_LEN=512
CONFIG_WANTED_MAX_DRIVERS_CNT=8
CONFIG_WANTED_MAX_OPTIONS_SIZE=256

CONFIG_WANTED_VFS_SOCKET_LISTEN=y

CONFIG_WANTED_SUPERVISOR_WSH=y
CONFIG_WANTED_DEFAULT_CONFIG="configs/bringup-rp2350-wsh.json"

# Makes `make defconfig pimoroni_pico2_plus_w_wsh && make build` alone reach
# the right target, board and defconfig.
CONFIG_WANTED_TARGET_NUTTX=y
CONFIG_WANTED_TARGET_NUTTX_BOARD="pimoroni-pico-2-plus-w:wsh"
CONFIG_WANTED_TARGET_NUTTX_DEFCONFIG="pimoroni_pico2_plus_w_wsh"
CONFIG_WANTED_IMAGE_SIGNING_KEYS="1:5209343fc3ed2c1875d8e4e0b133004b35fbbe09b59d93bf22f82ea3cab8b0bc"
