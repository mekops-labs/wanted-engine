# WANTED engine — ESP-IDF host-edge glue. Engine values live in the
# engine's own Kconfig; only edges into ESP-IDF's symbols belong here. A
# CONFIG_WANTED_* symbol here would shadow the engine's.

menu "WANTED engine"

config WANTED_ESP_TLS
    bool "TLS secure sockets (mbedTLS)"
    default n
    select MBEDTLS_TLS_ENABLED
    help
        Backs the engine's secure socket types (tcps://, udps://) with
        ESP-IDF's mbedTLS. Without it secure socket entries are rejected
        at wapp launch.

endmenu
