# Chip-independent WANTED-on-ESP-IDF defaults. Chip-specific PSRAM/console/
# flash-size settings live in sdkconfig.defaults.<chip> (esp32, esp32s3),
# applied alongside this file via SDKCONFIG_DEFAULTS (see Justfile).

# Custom partition table: A/B on the S3, single factory app on the classic
# part — generated from the matching .csv.in by board-defconfig.cmake.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The layer cache names each entry by its full OCI digest -- "sha256:" plus
# 64 hex, so 71 characters -- and the supervisor also writes registry entries
# under those names. The component default of 64 is below that, so a staged
# layer fails to land with a name-too-long error that reads as a transport
# fault. 96 leaves headroom without inflating littlefs's per-file metadata.
#
# littlefs records name_max in the superblock and honours the smaller of that
# and the configured value, so a device formatted under the old limit keeps it
# until its persist partition is reformatted.
CONFIG_LITTLEFS_OBJ_NAME_LEN=96

# POSIX threads for the wapp lifecycle (matches the Linux/NuttX platform).
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# app_main's own selftest drives LittleFS/registry paths directly (mount,
# opendir/readdir, fopen) on the main task, which is stack-hungrier than the
# default 3584 B budget — a 4 KiB PATH_MAX-sized local plus littlefs's own
# frames overflowed it. Matches the worker stack bump above.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WAMR feature set, matching the NuttX built-in app: classic interpreter,
# libc-builtin, reference types, bulk memory, and the thread manager. Thread
# manager is required — the interpreter's terminate check
# (WASM_SUSPEND_FLAG_TERMINATE) compiles in only with it, so without it
# wasm_runtime_terminate sets a flag nothing reads and a cooperative wapp stop
# never ends. AOT, fast interpreter, libc-wasi, WASM lib-pthread and shared
# memory stay off (their Kconfig defaults are otherwise pulled in).
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_CLASSIC=y
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
CONFIG_WAMR_ENABLE_REF_TYPES=y
CONFIG_WAMR_ENABLE_BULK_MEMORY=y
CONFIG_WAMR_ENABLE_THREAD_MGR=y
CONFIG_WAMR_ENABLE_AOT=n
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_LIB_PTHREAD=n
CONFIG_WAMR_ENABLE_SHARED_MEMORY=n

# A task watchdog that only prints leaves a wedged board wedged, and the boot
# that follows a reset now carries the log that preceded it.
CONFIG_ESP_TASK_WDT_PANIC=y
