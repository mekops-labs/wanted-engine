# WANTED engine — deployment settings. The service stays down until manager is
# set. Identity (device id, trusted key) comes from Sheriff's provisioning
# blob at /srv/wanted/sheriff/provision, not from here — see the Deputy
# enrolment flow.
#
#   uci set wanted.main.manager='tcps://marshal.example:8443'
#   uci commit wanted && /etc/init.d/wanted restart

config wanted 'main'
	# Empty takes the system hostname; overridden by the provisioning blob's
	# device_id once enrolled.
	option device_id ''

	option manager ''
	option registry ''            # optional
	option sync_interval ''       # optional; reconcile cadence in seconds
