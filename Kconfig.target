# Build orchestration: which target `just build` builds. Absent from
# wanted-autoconf.h, so engine code cannot test it. Boards and SDKs are
# pass-through strings, never enumerated.

menu "Target"

choice
	prompt "Build target"
	default WANTED_TARGET_LINUX
	help
	  Which target `just build` builds. Each keeps its own build
	  directory and .config, so two can be configured side by side.

config WANTED_TARGET_LINUX
	bool "linux — host engine + CLI"
	help
	  The hosted build: engine, CLI, unit suite, lint and coverage. What CI
	  and the devcontainer build by default.

config WANTED_TARGET_NUTTX
	bool "nuttx — NuttX built-in application"
	help
	  Cross-builds the engine as a NuttX app, for the simulator or real
	  hardware depending on the board below.

config WANTED_TARGET_ESP_IDF
	bool "esp-idf — ESP-IDF firmware"
	help
	  Builds firmware through idf.py, with the engine as an ESP-IDF
	  component.

config WANTED_TARGET_OPENWRT
	bool "openwrt — OpenWrt package"
	help
	  Cross-builds an .ipk from an OpenWrt SDK.

endchoice

# Derived from the choice, no prompt: a prompted string would freeze at
# its user value and go stale the moment the choice changed.
config WANTED_TARGET
	string
	default "linux" if WANTED_TARGET_LINUX
	default "nuttx" if WANTED_TARGET_NUTTX
	default "esp-idf" if WANTED_TARGET_ESP_IDF
	default "openwrt" if WANTED_TARGET_OPENWRT

config WANTED_TARGET_NUTTX_BOARD
	string "NuttX board configuration"
	depends on WANTED_TARGET_NUTTX
	default "sim:wanted"
	help
	  Passed to NuttX's tools/configure.sh unchanged, in its own
	  <board>:<config> notation — sim:wanted for the simulator,
	  esp32-devkitc:wanted for the classic ESP32.

config WANTED_TARGET_ESP_IDF_CHIP
	string "ESP-IDF chip target"
	depends on WANTED_TARGET_ESP_IDF
	default "esp32s3"
	help
	  Passed to `idf.py set-target` unchanged.

choice
	prompt "OpenWrt SDK"
	depends on WANTED_TARGET_OPENWRT
	default WANTED_OPENWRT_SDK_AARCH64
	help
	  Which SDK cross-builds the package. The two generic SDKs target an
	  architecture, not a router; pick custom to name any other OpenWrt
	  target by URL.

config WANTED_OPENWRT_SDK_AARCH64
	bool "aarch64 — generic 64-bit ARM (armsr/armv8)"

config WANTED_OPENWRT_SDK_MIPSEL
	bool "mipsel — generic 32-bit MIPS (malta/le)"

config WANTED_OPENWRT_SDK_CUSTOM
	bool "custom — SDK URL or local directory"

endchoice

config WANTED_TARGET_OPENWRT_SDK_URL
	string "OpenWrt SDK URL or directory"
	depends on WANTED_OPENWRT_SDK_CUSTOM
	help
	  A URL to an OpenWrt SDK archive (cached under .openwrt-sdk/ on
	  first use) or a path to one already extracted. Target, architecture
	  and toolchain prefix are auto-detected from its staging_dir layout.

# Derived from the choice above, no prompt: one string for the build to read,
# whether it came from a keyword or a URL. sdk-env.sh already accepted all three
# forms — the choice only makes that visible in the menu.
config WANTED_TARGET_OPENWRT_SDK
	string
	default "aarch64" if WANTED_OPENWRT_SDK_AARCH64
	default "mipsel" if WANTED_OPENWRT_SDK_MIPSEL
	default WANTED_TARGET_OPENWRT_SDK_URL if WANTED_OPENWRT_SDK_CUSTOM

# CMake-only knobs: change how the build runs, not what the engine is,
# so they stay out of wanted-autoconf.h and out of Kconfig.engine (NuttX
# and ESP-IDF run no CMake of ours and could not honour them).
menu "Host build options"
	depends on WANTED_TARGET_LINUX || WANTED_TARGET_OPENWRT

config WANTED_BUILD_COVERAGE
	bool "Instrument for code coverage"
	default n
	help
	  Compile and link everything with --coverage at -O0, so `just coverage`
	  can produce a report. Must be set before any target is defined, so it
	  applies to the engine library itself rather than only the test binary.

config WANTED_BUILD_STATIC_CLI
	bool "Link wanted-cli statically"
	default n
	help
	  Link the CLI with -static, for a single binary with no matching
	  shared libraries. Secure sockets need a static OpenSSL (the build
	  image ships shared-only); glibc still dlopen's NSS for hostnames.

config WANTED_EXTRA_DRIVERS_DIR
	string "Out-of-tree driver source directory"
	default ""
	help
	  A source tree outside this repo supplying ExtraDriverTable(),
	  compiled in. Searched last, so it cannot shadow a core name. Runs
	  at full engine privilege; empty compiles in a stub returning NULL.

endmenu

endmenu

# The launch config the build ships: a file beside the binary (linux), a
# package conffile (openwrt), or a blob in the image (esp-idf, nuttx). A
# path rather than a menu of configs/, so nothing here drifts from it.
menu "Default configuration"

config WANTED_DEFAULT_CONFIG
	string "Default configuration file"
	default "configs/example_config.json"
	help
	  JSON to ship as the engine's launch config, relative to the repo
	  root or absolute — see configs/example_config.json for the schema.
	  Parsed at build time; one that does not parse fails the build.

endmenu
