# What the engine binary IS. Authoritative and host-agnostic.
#
# Every symbol here reaches wanted-autoconf.h and therefore the compiler. Build
# orchestration — which target, which board, which SDK — is Kconfig.target's,
# and must not appear here: a host that compiles engine sources into its own
# tree sources THIS file, and has already answered those questions itself.
#
# Two rules, both load-bearing:
#   1. Every symbol is prefixed CONFIG_WANTED_. Engine and host symbols reach
#      the same TU on NuttX and ESP-IDF; an unprefixed name will collide.
#   2. Never reference a host symbol here. This file is read standalone too,
#      and kconfiglib resolves an unknown symbol to n with at most a warning —
#      the feature vanishes silently. Host edges go in that host's Kconfig.

menu "General"

config WANTED_DEBUG_TRACES
	bool "Debug traces"
	default n
	help
	  Compile in the DEBUG_TRACE() call sites scattered through the engine:
	  VFS routing decisions, wapp lifecycle transitions, driver open/close.
	  Off, they expand to nothing and cost neither code nor a branch.

	  Development aid, not an operational log. The traces are written with a
	  raw write() to stderr, bypassing the per-wapp log capture, and they are
	  verbose enough to change timing on a constrained target. The engine's
	  normal reporting is /proc and the log mount, which are always present.

endmenu

menu "VFS drivers"

config WANTED_VFS_9P
	bool "9p — 9P2000 client for an external driver server"
	default y
	help
	  Mounts a filesystem served by an out-of-engine 9P2000 server over tcp,
	  udp, or a local socket — the supported path for a driver that should run
	  outside the trust boundary. Drags in the vendored c9 library.

config WANTED_VFS_INFLATE
	bool "inflate — streaming gzip decompression device"
	default y
	help
	  /dev/inflate: write compressed bytes, read the decompressed stream.
	  Drags in vendored uzlib and a 32 KiB DEFLATE window.

config WANTED_VFS_SOCKET
	bool "socket — TCP/UDP and TLS network connections"
	default y
	help
	  Backs the sockets[] section at /net/<name>. Without it a config naming a
	  socket fails its launch with -ENODEV.

config WANTED_VFS_SOCKET_TLS
	bool "secure sockets (TLS)"
	depends on WANTED_VFS_SOCKET
	default y
	help
	  Adds the tcps:// and udps:// transports to the socket driver.

	  The engine states the intent here; the backend is the host's — OpenSSL
	  on Linux, mbedTLS on NuttX and ESP-IDF. A host that cannot provide one
	  fails the build rather than quietly handing back a binary whose secure
	  socket entries are rejected at wapp launch.

	  Certificate verification is not implemented on any backend: connections
	  are encrypted but unauthenticated.

config WANTED_VFS_SOCKET_LISTEN
	bool "listening sockets (servers)"
	depends on WANTED_VFS_SOCKET
	default n
	help
	  Adds the listen role to the sockets[] section: a wapp binds a port and
	  serves it. A tcp/tcps entry binds, listens and accepts — each accepted
	  connection becomes its own fd; a udp/udps entry binds a datagram socket
	  read with recv and answered with send.

	  A leaf sensor node never serves, so this costs it nothing until a target
	  asks for it. Turn it on for a wapp-served web UI or a protocol gateway.

	  A launch config carrying "role": "listen" on a build without this fails
	  the wapp's launch rather than silently opening an outbound connection.

config WANTED_VFS_SOCKET_MAX_CONNS
	int "Accepted connections per listener"
	depends on WANTED_VFS_SOCKET_LISTEN
	default 4
	range 1 32
	help
	  Hard cap on connections a listener holds open at once, sizing a table
	  paid per listening socket. A launch config's max_conns lowers it further;
	  neither raises it. Accepting past the cap returns -ENFILE.

config WANTED_VFS_SHA256
	bool "sha256 — streaming digest device"
	default y
	help
	  /dev/sha256: write message bytes, read the hex digest. May be backed by
	  a hardware engine.

config WANTED_VFS_ED25519
	bool "ed25519 — signature verification device"
	default y
	help
	  /dev/ed25519: write public key, signature and message, read the verdict.
	  For wapps verifying their own payloads; engine image verification does
	  not use it.

config WANTED_VFS_CONFIG
	bool "config — read-only config-file injection"
	default y
	help
	  Mounts a config file into the wapp namespace at a chosen path.

config WANTED_VFS_LOGMOUNT
	bool "logmount — read-only view of captured wapp logs"
	default y
	help
	  Backs a mounts[] entry named `log`: the per-wapp log rings as a readable
	  directory. Read side only — the capturing console driver is always in.


config WANTED_LOGMOUNT_MAX_OPEN
	int "Concurrent open handles on a log mount"
	depends on WANTED_VFS_LOGMOUNT
	default 8
	range 1 64
	help
	  Reader slots in the log mount's fd table.

config WANTED_VFS_GPIO
	bool "gpio — per-pin digital I/O"
	default y
	help
	  /dev/gpio/<name>/{value,direction}: one subtree per pin the launch
	  config granted. The grant maps a wapp-visible name onto a platform
	  address, so a wapp image stays board-portable. Needs a PlatformGpio*
	  backing — present on ESP-IDF and NuttX, absent on Linux, where a grant
	  fails the launch until the libgpiod backing lands.

config WANTED_VFS_UART
	bool "uart — serial port"
	default n
	help
	  /dev/uart/<port>/{data,baud,format}: one subtree per port the launch
	  config granted, with the line settings writable at runtime because one
	  link can carry two of them. One wapp holds a port exclusively; routing
	  several logical users onto one link is a broker wapp's job. Needs a
	  PlatformUart* backing — present on ESP-IDF and Linux, absent on NuttX,
	  where a grant fails the launch.

config WANTED_VFS_OTA
	bool "ota — A/B firmware update"
	default y
	help
	  /dev/ota control node plus /dev/ota/slot image sink, over PlatformOta*.
	  Deselect on a target with no A/B mechanism to update into — an OpenWRT
	  host is updated by its own package manager, not through this driver.

config WANTED_VFS_WANTED
	bool "wanted — the control-plane namespace"
	default y
	help
	  /dev/wanted: the privileged lifecycle/registry namespace a supervisor
	  drives. Deselect only for a fixed-function node with no supervisor —
	  without it nothing can start, stop or install a wapp at runtime.


menu "Built-in driver options"

config WANTED_PIPE_BUF_SIZE
	int "Bytes per named pipe"
	default 4096
	range 256 65536
	help
	  Ring buffer for one /dev/pipe channel.

config WANTED_PIPE_MAX_PIPES
	int "Concurrent named pipes"
	default 8
	range 1 64
	help
	  The pipe store is ONE engine-wide instance of count * buf bytes,
	  allocated whether or not any wapp opens /dev/pipe — 32 KiB at the
	  defaults, ~6 % of a 512 KiB part. Raising it also grows a stack frame:
	  the driver's readdir sizes a local array by this.

config WANTED_GPIO_MAX_PINS
	int "Pins per gpio grant"
	default 8
	range 1 32
	help
	  Pins one wapp's gpio grant may name. Sizes a per-wapp table of names
	  and addresses, and a local array in the driver's readdir.

config WANTED_UART_BUF_SIZE
	int "Bytes per UART ring, each direction"
	depends on WANTED_VFS_UART
	default 512
	range 128 8192
	help
	  Receive and transmit ring the backing installs for a granted port. The
	  receive ring bounds how far a wapp can fall behind a talking peer before
	  bytes are lost.

config WANTED_OTA_SLOT_ROOT
	string "OTA slot directory (host backings)"
	depends on WANTED_VFS_OTA
	default "/boot"
	help
	  Directory holding slot_a/, slot_b/ and the active_slot.txt pointer. Used
	  by backings that stage into a filesystem; ignored where the slots are
	  flash partitions.

config WANTED_OTA_IMAGE_NAME
	string "Image filename inside a slot"
	depends on WANTED_VFS_OTA
	default "zImage"
	help
	  Filename written inside slot_a/ or slot_b/. The bootloader picks the slot
	  by directory, so this name is the same in both.

config WANTED_LOG_CAP
	int "Bytes retained per wapp log"
	default 2048
	range 256 65536
	help
	  Most-recent output kept per wapp, times WANTED_MAX_WAPPS.

endmenu

endmenu

menu "Supervisor"

choice
	prompt "Supervisor image"
	default WANTED_SUPERVISOR_SHERIFF
	help
	  Which supervisor TAR the engine boots. Read by path, not compiled in;
	  the choice selects the path, the image is built separately.

config WANTED_SUPERVISOR_SHERIFF
	bool "sheriff — production control-plane agent"
	help
	  Reconciles against a control plane and manages wapp lifecycle. Built
	  from its own repository.

config WANTED_SUPERVISOR_WSH
	bool "wsh — interactive debug shell"
	help
	  Console shell for driving the control plane by hand. Development and
	  the system-control tests, not for a deployed node.

config WANTED_SUPERVISOR_SELFTEST
	bool "selftest — in-WASM test orchestrator"
	help
	  Runs the functional suite from inside WASM and reports TAP. A node
	  configured with it runs tests and exits.

endchoice

# Derived from the choice, no prompt: a prompted string freezes at its user
# value, so switching the choice would leave the path stale.
config WANTED_SUPERVISOR_IMAGE
	string
	default "./wasm/supervisor/sheriff/supervisor.tar" if WANTED_SUPERVISOR_SHERIFF
	default "./wasm/supervisor/wsh/supervisor.tar" if WANTED_SUPERVISOR_WSH
	default "./wasm/supervisor/selftest/supervisor.tar" if WANTED_SUPERVISOR_SELFTEST

config WANTED_SUPERVISOR_IMAGE_PATH
	string "Supervisor image path override"
	default ""
	help
	  Absolute path to a packaged supervisor image (e.g.
	  /usr/share/wanted/supervisor.tar). Empty means the choice above decides;
	  this is for where the image *lives*, not which variant it is.

endmenu

menu "Resource limits"

comment "These size static tables and per-instance WAMR allocations. Changing"
comment "one resizes static structures — audit every array dimensioned by it."

config WANTED_MAX_WAPPS
	int "Maximum concurrent wapp instances"
	default 3
	range 1 64
	help
	  Dimensions the per-platform slot tables and the per-wapp log rings — the
	  dominant term in the engine's static footprint. The supervisor occupies
	  one slot, so 1 leaves room for no child wapps.

config WANTED_WASM_STACK_SIZE
	int "WASM operand stack per instance (bytes)"
	default 8192
	range 1024 1048576
	help
	  The interpreter's evaluation stack, in host memory outside linear
	  memory. A wapp that exhausts it traps.

config WANTED_WASM_HEAP_SIZE
	int "WASM app heap per instance (bytes)"
	default 8192
	range 0 1048576
	help
	  Host-managed allocator outside linear memory. Zero disables it.

config WANTED_WASM_MAX_MEMORY_PAGES
	int "Linear-memory cap per wapp (64 KiB pages, 0 = unbounded)"
	default 1
	range 0 512
	help
	  The only region the module can load and store. An image declaring more
	  initial memory than this is refused at load. Zero lifts the cap — safe
	  only behind a real memory manager.

config WANTED_WASM_WORKER_STACK_SIZE
	int "Worker thread native C stack (bytes)"
	default 65536
	range 16384 1048576
	help
	  Native stack for a wapp's thread, floored by the platform minimum.
	  Distinct from the WASM operand stack above.

config WANTED_MAX_PATH_LEN
	int "Maximum VFS path length (bytes)"
	default 256
	range 64 4096
	help
	  Bounds every path buffer. Paths are composed, so a value tight enough to
	  truncate a mount path plus a file name surfaces as failed opens.

config WANTED_MAX_DRIVERS_CNT
	int "Launch-config entries per resource section"
	default 6
	range 1 32
	help
	  Sizes drivers[], mounts[] and sockets[] each — paid three times per
	  configured wapp.

config WANTED_MAX_OPTIONS_SIZE
	int "Launch-config options string (bytes)"
	default 128
	range 32 1024
	help
	  Per-entry options blob. A 9P address or a bind mount's src= must fit.


endmenu
